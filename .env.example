# ---- LLM backends (lyra_ai picks the first one that is set) ----
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# ---- Vision (lyra-vision) ----
# Gemini is preferred; falls back to OpenRouter if only that is set.
GOOGLE_API_KEY=

# ---- Speech ----
WHISPER_MODEL=base
TTS_ENGINE=kokoro
KOKORO_VOICE=bf_emma

# ---- Service URLs (defaults are fine for a single machine) ----
EMBODIMENT_URL=http://localhost:8000
VOICE_URL=http://localhost:8001
LISTEN_URL=http://localhost:8002
VISION_URL=http://localhost:8003
